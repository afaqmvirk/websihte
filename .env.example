# Server-only, sending-only Resend key restricted to stupideas.com.
APPLICATION_EMAIL_API_KEY=

# Existing optional mailing-list key and segment (Contacts permissions required).
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# APPLICATION_EMAIL_TO receives a private application copy.
APPLICATION_EMAIL_FROM=applications@stupideas.com
APPLICATION_EMAIL_TO=stupidideashackathon@gmail.com
APPLICATION_EMAIL_REPLY_TO=applications@stupideas.com

# Required application backend. Keep the secret key server-only; never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only webhook for the organizer Discord server's #firehose channel.
DISCORD_APPLICATION_WEBHOOK_URL=

# sih-inator mention bot. Keep the token and cron secret server-only.
OPENAI_API_KEY=
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=1483863305360511016
DISCORD_BOT_MODEL=gpt-6-luna
DISCORD_BOT_DAILY_LIMIT=10000
DISCORD_BOT_MONTHLY_LIMIT=310000
DISCORD_BOT_COOLDOWN_SECONDS=2
# Rick is a separate Discord application with his own bot token and installation.
DISCORD_RICK_ENABLED=false
DISCORD_RICK_BOT_TOKEN=
DISCORD_RICK_APPLICATION_ID=
# Krab replies deterministically without OpenAI; use a third Discord application.
DISCORD_KRAB_ENABLED=false
DISCORD_KRAB_BOT_TOKEN=
DISCORD_KRAB_APPLICATION_ID=
# Shared image allowance across both bots. One fixed low-quality JPEG per human request.
DISCORD_BOT_IMAGES_ENABLED=true
DISCORD_BOT_IMAGE_DAILY_LIMIT=25
CRON_SECRET=
