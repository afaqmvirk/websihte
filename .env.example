# Server-only, sending-only Resend key restricted to stupideas.com.
APPLICATION_EMAIL_API_KEY=

# Existing optional mailing-list key and segment (Contacts permissions required).
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# APPLICATION_EMAIL_TO receives a private application copy.
APPLICATION_EMAIL_FROM=applications@stupideas.com
APPLICATION_EMAIL_TO=stupidideashackathon@gmail.com
APPLICATION_EMAIL_REPLY_TO=applications@stupideas.com

# Required application backend. Keep the secret key server-only; never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only webhook for the organizer Discord server's #firehose channel.
DISCORD_APPLICATION_WEBHOOK_URL=
